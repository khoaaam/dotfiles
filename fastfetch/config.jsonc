{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "width": 1,
        "height": 1,
        "padding": {
            "top": 1,
            "left": 2
        }
    },
    "display": {
        "separator": "->   ",
        "color": {
            "separator": "red"
        }
    },
    "modules": [
        "break",
        "break",
        "break",
        
        {
            "key": "Distro      ",
            "type": "os"
        },
        {
            "key": "Kernel      ",
            "type": "kernel",
            "format": "{sysname} {release}"
        },
        //{
        //    "key": "Packages    ",
        //    "type": "packages"
        //},
        {
            "key": "WM          ",
            "type": "wm"
        },
        {
            "key": "Terminal    ",
            "type": "terminal"
        },
        {
            "key": "Font        ",
            "type": "terminalfont"
        },
        {
            "key": "Shell       ",
            "type": "shell"
        },
        {
            "key": "Host        ",
            "type": "host"
        },
        {
            "key": "CPU         ",
            "type": "cpu"
        },
        {
            "key": "GPU         ",
            "type": "gpu"
        },
        {
            "key": "Disk        ",
            "type": "disk"
        },
        {
            "key": "Display     ",
            "type": "display",
            "compactType": "original-with-refresh-rate"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 6,
            "symbol": "circle"
        }
    ]
}
